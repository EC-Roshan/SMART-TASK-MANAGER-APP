<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/nav_home">


    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.smarttaskmanager.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">


        <action
            android:id="@+id/action_nav_home_to_addTaskFragment"
            app:destination="@id/addTaskFragment" />
    </fragment>


    <fragment
        android:id="@+id/nav_setting"
        android:name="com.example.smarttaskmanager.ui.setting.SettingFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_setting" />


    <fragment
        android:id="@+id/nav_report"
        android:name="com.example.smarttaskmanager.ui.statisticreport.StatisticReportFragment"
        android:label="Report"
        tools:layout="@layout/fragment_statisticreport" />


    <fragment
        android:id="@+id/nav_aboutus"
        android:name="com.example.smarttaskmanager.ui.aboutus.AboutusFragment"
        android:label="About Us"
        tools:layout="@layout/fragment_aboutus" />

   
    <fragment
        android:id="@+id/addTaskFragment"
        android:name="com.example.smarttaskmanager.AddTaskFragment"
        android:label="Add Task"
        tools:layout="@layout/fragment_add_task" />

</navigation>